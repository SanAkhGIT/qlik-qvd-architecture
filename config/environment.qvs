// Qlik Sense environment configuration
// Create a folder data connection named QlikQVDArchitecture that points to the
// cloned repository root (or adjust these paths for your environment).
// Keep secrets and environment-specific overrides out of source control.

SET vSourcePath = 'lib://QlikQVDArchitecture/data/sample/';
SET vRawQvdPath = 'lib://QlikQVDArchitecture/qvd/raw/';
SET vTransformQvdPath = 'lib://QlikQVDArchitecture/qvd/transform/';
SET vSemanticQvdPath = 'lib://QlikQVDArchitecture/qvd/semantic/';
SET vAuditQvdPath = 'lib://QlikQVDArchitecture/qvd/audit/';
SET vDQFailOnError = 1;
SET vIncrementalLookbackDays = 1;

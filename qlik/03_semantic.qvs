// SEMANTIC LAYER
// Application-ready star model: one fact linked to conformed dimensions.

SET ErrorMode=1;
SET DateFormat='YYYY-MM-DD';

$(Must_Include=lib://QlikQVDArchitecture/config/environment.qvs);
LET vLoadTimestamp = Timestamp(Now(1));

Customers:
LOAD CustomerID, CustomerName, Region, Country, Segment
FROM [$(vTransformQvdPath)Customers.qvd] (qvd);

Products:
LOAD ProductID, ProductName, Category, Subcategory, UnitPrice
FROM [$(vTransformQvdPath)Products.qvd] (qvd);

FactOrders:
LOAD OrderID, OrderDate, CustomerID, ProductID, Quantity, Discount, SalesAmount,
     If(Quantity <> 0, SalesAmount / Quantity) as NetUnitSales,
     Year(OrderDate) as OrderYear,
     Month(OrderDate) as OrderMonth,
     '$(vLoadTimestamp)' as DataLoadTimestamp
FROM [$(vTransformQvdPath)Orders.qvd] (qvd);

TempMinMax:
LOAD Min(OrderDate) as MinDate, Max(OrderDate) as MaxDate
RESIDENT FactOrders;

LET vMinDate = Num(Peek('MinDate', 0, 'TempMinMax'));
LET vMaxDate = Num(Peek('MaxDate', 0, 'TempMinMax'));
DROP TABLE TempMinMax;

IF $(vMinDate) <= $(vMaxDate) THEN
    CanonicalCalendar:
    LOAD Date($(vMinDate) + IterNo() - 1) as OrderDate,
         Year($(vMinDate) + IterNo() - 1) as CalendarYear,
         Month($(vMinDate) + IterNo() - 1) as CalendarMonth,
         MonthName($(vMinDate) + IterNo() - 1) as CalendarMonthYear,
         Week($(vMinDate) + IterNo() - 1) as CalendarWeek,
         WeekDay($(vMinDate) + IterNo() - 1) as CalendarWeekDay,
         QuarterName($(vMinDate) + IterNo() - 1) as CalendarQuarter,
         If(WeekDay($(vMinDate) + IterNo() - 1) < 5, 1, 0) as IsWeekday
    AUTOGENERATE 1
    WHILE $(vMinDate) + IterNo() - 1 <= $(vMaxDate);

    STORE CanonicalCalendar INTO [$(vSemanticQvdPath)CanonicalCalendar.qvd] (qvd);
    DROP TABLE CanonicalCalendar;
ENDIF

STORE Customers INTO [$(vSemanticQvdPath)Customers.qvd] (qvd);
STORE Products INTO [$(vSemanticQvdPath)Products.qvd] (qvd);
STORE FactOrders INTO [$(vSemanticQvdPath)FactOrders.qvd] (qvd);

DROP TABLE Customers;
DROP TABLE Products;
DROP TABLE FactOrders;

TRACE SEMANTIC LAYER COMPLETE;

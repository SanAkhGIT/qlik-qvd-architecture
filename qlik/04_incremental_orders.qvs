// INCREMENTAL ORDER LOAD
// Demonstrates a safe QVD pattern for new/changed records.
// A small look-back window protects against late-arriving source records.
// Determinism: OrderID + ModifiedTimestamp + OrderVersion form the tie-breaker.
// Limitation: source deletes are not represented by this extract and require
// an explicit CDC/delete feed in a production implementation.

SET ErrorMode=1;
SET DateFormat='YYYY-MM-DD';
SET TimestampFormat='YYYY-MM-DD hh:mm:ss';

$(Must_Include=lib://QlikQVDArchitecture/config/environment.qvs);

LET vExistingQvd = '$(vTransformQvdPath)Orders.qvd';
LET vLastModifiedNum = Num(Date#('1900-01-01', 'YYYY-MM-DD'));

IF FileSize('$(vExistingQvd)') > 0 THEN
    ExistingOrders:
    LOAD OrderID, OrderDate, CustomerID, ProductID, Quantity, Discount,
         SalesAmount, ModifiedTimestamp, OrderVersion
    FROM [$(vExistingQvd)] (qvd);

    LatestModified:
    LOAD Max(Num(ModifiedTimestamp)) as LatestModifiedNum
    RESIDENT ExistingOrders;
    LET vLastModifiedNum = Peek('LatestModifiedNum', 0, 'LatestModified');
    DROP TABLE LatestModified;
ELSE
    ExistingOrders:
    LOAD * INLINE [
        OrderID, OrderDate, CustomerID, ProductID, Quantity, Discount, SalesAmount, ModifiedTimestamp, OrderVersion
    ];
ENDIF

LET vIncrementalCutoffNum = $(vLastModifiedNum) - $(vIncrementalLookbackDays);

NewOrders:
LOAD Trim(OrderID) as OrderID,
     Date(Date#(Trim(OrderDate), 'YYYY-MM-DD')) as OrderDate,
     Trim(CustomerID) as CustomerID,
     Trim(ProductID) as ProductID,
     Num(Quantity) as Quantity,
     Num(Discount) as Discount,
     Num(SalesAmount) as SalesAmount,
     Timestamp(Timestamp#(Trim(ModifiedDate), 'YYYY-MM-DD')) as ModifiedTimestamp,
     1 as OrderVersion
FROM [$(vSourcePath)orders.csv]
(txt, codepage is 65001, embedded labels, delimiter is ',', msq)
WHERE Num(Timestamp(Timestamp#(Trim(ModifiedDate), 'YYYY-MM-DD'))) >= $(vIncrementalCutoffNum)
  AND Len(Trim(OrderID)) > 0
  AND Num(Quantity) > 0
  AND Num(SalesAmount) >= 0;

CONCATENATE (ExistingOrders)
LOAD * RESIDENT NewOrders;

Orders_Deduplicated:
NoConcatenate
LOAD OrderID,
     FirstSortedValue(OrderDate, -(Num(ModifiedTimestamp) * 1000000 + OrderVersion)) as OrderDate,
     FirstSortedValue(CustomerID, -(Num(ModifiedTimestamp) * 1000000 + OrderVersion)) as CustomerID,
     FirstSortedValue(ProductID, -(Num(ModifiedTimestamp) * 1000000 + OrderVersion)) as ProductID,
     FirstSortedValue(Quantity, -(Num(ModifiedTimestamp) * 1000000 + OrderVersion)) as Quantity,
     FirstSortedValue(Discount, -(Num(ModifiedTimestamp) * 1000000 + OrderVersion)) as Discount,
     FirstSortedValue(SalesAmount, -(Num(ModifiedTimestamp) * 1000000 + OrderVersion)) as SalesAmount,
     Max(ModifiedTimestamp) as ModifiedTimestamp,
     FirstSortedValue(OrderVersion, -OrderVersion) as OrderVersion
RESIDENT ExistingOrders
GROUP BY OrderID;

STORE Orders_Deduplicated INTO [$(vExistingQvd)] (qvd);
DROP TABLE Orders_Deduplicated;
DROP TABLE ExistingOrders;
DROP TABLE NewOrders;

TRACE INCREMENTAL ORDERS LOAD COMPLETE;

// INCREMENTAL ORDER LOAD
// Demonstrates the common QVD incremental pattern: load only records newer
// than the latest timestamp already persisted in the transform layer.

$(Must_Include=../config/environment.qvs);

LET vExistingQvd = '$(vTransformQvdPath)Orders.qvd';

IF FileSize('$(vExistingQvd)') > 0 THEN
    ExistingOrders:
    LOAD
        OrderID,
        OrderDate,
        CustomerID,
        ProductID,
        Quantity,
        Discount,
        SalesAmount,
        ModifiedTimestamp
    FROM [$(vExistingQvd)] (qvd);

    LatestModified:
    LOAD Max(ModifiedTimestamp) as LatestModifiedTimestamp
    RESIDENT ExistingOrders;

    LET vLastModified = Timestamp(Peek('LatestModifiedTimestamp', 0, 'LatestModified'));
    DROP TABLE LatestModified;
ELSE
    LET vLastModified = '1900-01-01 00:00:00';
ENDIF

NewOrders:
LOAD
    Trim(OrderID) as OrderID,
    Date(Date#(OrderDate, 'YYYY-MM-DD')) as OrderDate,
    Trim(CustomerID) as CustomerID,
    Trim(ProductID) as ProductID,
    Num(Quantity) as Quantity,
    Num(Discount) as Discount,
    Num(SalesAmount) as SalesAmount,
    Timestamp(Timestamp#(ModifiedDate, 'YYYY-MM-DD')) as ModifiedTimestamp
FROM [$(vSourcePath)orders.csv]
(txt, codepage is 65001, embedded labels, delimiter is ',', msq)
WHERE Timestamp(Timestamp#(ModifiedDate, 'YYYY-MM-DD')) > Timestamp('$(vLastModified)');

IF NoOfRows('NewOrders') > 0 THEN
    CONCATENATE (ExistingOrders)
    LOAD * RESIDENT NewOrders;
ENDIF

IF TableNumber('ExistingOrders') >= 0 THEN
    Orders_Deduplicated:
    NoConcatenate
    LOAD
        OrderID,
        FirstSortedValue(OrderDate, -ModifiedTimestamp) as OrderDate,
        FirstSortedValue(CustomerID, -ModifiedTimestamp) as CustomerID,
        FirstSortedValue(ProductID, -ModifiedTimestamp) as ProductID,
        FirstSortedValue(Quantity, -ModifiedTimestamp) as Quantity,
        FirstSortedValue(Discount, -ModifiedTimestamp) as Discount,
        FirstSortedValue(SalesAmount, -ModifiedTimestamp) as SalesAmount,
        Max(ModifiedTimestamp) as ModifiedTimestamp
    RESIDENT ExistingOrders
    GROUP BY OrderID;

    STORE Orders_Deduplicated INTO [$(vExistingQvd)] (qvd);
    DROP TABLE Orders_Deduplicated;
    DROP TABLE ExistingOrders;
ENDIF

DROP TABLE NewOrders;
